# Optional: shell needs no values. Copy to ignored .env.local; never paste secrets in chat.
# Server-side only: create your own key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Qwen is publicly listed as preview; Gjin must verify account access via /openai/v1/models.

# Optional Supabase connection (ask Alex). Public key is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# DO NOT add service-role key unless truly required, and NEVER use NEXT_PUBLIC_ for it.
# SUPABASE_SERVICE_ROLE_KEY=
